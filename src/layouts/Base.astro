---
import '@fontsource-variable/instrument-sans';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Aesymnetes</title>
  </head>
  <body>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* Cool, quiet surroundings so the wooden board is the only warm object on the page. */
  :root {
    color-scheme: light dark;
    --bg: #eceff1;
    --surface: #f8f9fa;
    --ink: #18212b;
    --muted: #5c6875;
    --line: #cdd4da;
    --accent: #1f4fa3;
    --good: #2f7d57;
    --bad: #b8392e;
    --font: 'Instrument Sans Variable', ui-sans-serif, 'Helvetica Neue', Arial, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12171d;
      --surface: #1a212a;
      --ink: #e3e8ed;
      --muted: #8d99a6;
      --line: #2c3640;
      --accent: #7fa8ee;
      --good: #6cc198;
      --bad: #ee8176;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    line-height: 1.5;
  }
  a {
    color: var(--accent);
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .site-main {
    max-width: 1600px;
    margin: 0 auto;
    padding: 24px 16px;
  }
</style>
