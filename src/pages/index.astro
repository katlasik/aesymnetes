---
import Base from '../layouts/Base.astro';
---

<Base title="Drill">
  <div class="home">
    <h1>Aesymnetes</h1>
    <p class="lead">Four short chess exercises in a row: Missing piece, Repeat the moves, Find the square, Hanging pieces.</p>
    <a class="start" href="/drill">Start drill</a>
  </div>
</Base>

<style>
  .home {
    max-width: 560px;
  }
  h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 24px 0 8px;
  }
  .lead {
    color: var(--muted);
    margin: 0 0 24px;
  }
  .start {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 64px;
    padding: 0 32px;
    max-width: 340px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--bg);
    font-size: 1.375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .start:hover {
    filter: brightness(1.08);
  }
</style>
