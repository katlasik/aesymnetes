---
import Base from '../layouts/Base.astro';

const exercises = [
  {
    href: '/exercises/missing-piece',
    name: 'Missing piece',
    blurb: 'Memorise a position from a real game. One piece disappears. Say where it stood and what it was.',
  },
];
---

<Base title="Exercises">
  <h1>Exercises</h1>
  <ul class="exercise-list">
    {
      exercises.map((e) => (
        <li>
          <a href={e.href}>
            <span class="name">{e.name}</span>
            <span class="blurb">{e.blurb}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 24px 0 16px;
  }
  .exercise-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 560px;
  }
  .exercise-list a {
    display: block;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .exercise-list li:last-child a {
    border-bottom: 1px solid var(--line);
  }
  .name {
    display: block;
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--accent);
  }
  .exercise-list a:hover .name {
    text-decoration: underline;
  }
  .blurb {
    display: block;
    color: var(--muted);
  }
</style>
